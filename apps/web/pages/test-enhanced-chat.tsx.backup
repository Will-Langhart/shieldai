import React, { useState } from 'react';
import { useAuth } from '../lib/auth-context';

export default function TestEnhancedChat() {
  const { user } = useAuth();
  const [message, setMessage] = useState('');
  const [response, setResponse] = useState('');
  const [loading, setLoading] = useState(false);
  const [mode, setMode] = useState<'fast' | 'accurate'>('accurate');
  const [metadata, setMetadata] = useState<any>(null);

  // Example prompts showcasing enhanced capabilities
  const examplePrompts = [
    {
      category: 'Theological Deep Dive',
      prompts: [
        "Explain the Trinity using both biblical evidence and philosophical reasoning. Address common objections.",
        "How does the incarnation resolve the tension between God's transcendence and immanence?",
        "What is the relationship between divine sovereignty and human free will? Reference Reformed and Arminian perspectives."
      ]
    },
    {
      category: 'Problem of Evil (Advanced)',
      prompts: [
        "I'm angry at God. My child has cancer. How can a loving God allow this suffering?",
        "If God is all-powerful and all-good, why doesn't He stop evil? This seems logically contradictory.",
        "How do you reconcile natural disasters with a loving God? Thousands die from earthquakes."
      ]
    },
    {
      category: 'Scientific Objections',
      prompts: [
        "Evolution disproves Genesis. How can you believe in creation when science shows evolution is true?",
        "The universe is billions of years old, not 6000. How do you explain this contradiction?",
        "Quantum mechanics shows the universe is fundamentally random. Where is God in quantum uncertainty?"
      ]
    },
    {
      category: 'Historical Challenges',
      prompts: [
        "There's no historical evidence for the resurrection outside the Bible. Why should I believe it?",
        "The Gospels contradict each other. How can they be reliable historical documents?",
        "Many religions have dying and rising god myths. What makes Jesus different?"
      ]
    },
    {
      category: 'Personal Struggles',
      prompts: [
        "I've been a Christian for years but I'm losing my faith. I don't feel God anymore.",
        "I'm struggling with addiction and feel like God has abandoned me. Where is He?",
        "My prayers feel empty. I read the Bible but it's just words. Am I still saved?"
      ]
    },
    {
      category: 'Cultural Engagement',
      prompts: [
        "How should Christians engage with LGBTQ+ issues in today's culture?",
        "Is it wrong for Christians to be wealthy when there's so much poverty?",
        "How do we share the gospel in a post-Christian, secular society?"
      ]
    }
  ];

  const sendMessage = async () => {
    if (!message.trim() || !user) return;

    setLoading(true);
    setResponse('');
    setMetadata(null);

    try {
      const res = await fetch('/api/chat-enhanced', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          message,
          mode,
          sessionId: `test_${Date.now()}`,
        }),
      });

      if (!res.ok) {
        throw new Error('Failed to get response');
      }

      const reader = res.body?.getReader();
      const decoder = new TextDecoder();
      let fullResponse = '';
      let lastMetadata = null;

      while (reader) {
        const { done, value } = await reader.read();
        if (done) break;

        const chunk = decoder.decode(value);
        const lines = chunk.split('\n');

        for (const line of lines) {
          if (line.startsWith('data: ')) {
            try {
              const data = JSON.parse(line.slice(6));
              if (data.content) {
                fullResponse += data.content;
                setResponse(fullResponse);
              }
              if (data.metadata) {
                lastMetadata = data.metadata;
              }
              if (data.summary) {
                setMetadata(data.summary);
              }
            } catch (e) {
              // Skip invalid JSON
            }
          }
        }
      }
    } catch (error) {
      console.error('Error:', error);
      setResponse('Error: Failed to get response');
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="max-w-4xl mx-auto p-6">
      <h1 className="text-3xl font-bold mb-6">Enhanced Shield AI Chat Test</h1>
      
      <div className="mb-6 p-4 bg-blue-50 rounded-lg">
        <h2 className="text-lg font-semibold mb-2">Enhanced Features:</h2>
        <ul className="list-disc list-inside space-y-1 text-sm">
          <li>Deep context understanding with emotional tone detection</li>
          <li>Advanced theological and philosophical reasoning</li>
          <li>Personalized responses based on engagement level</li>
          <li>Memory of conversation patterns and preferences</li>
          <li>Scripture integration with contextual relevance</li>
          <li>Multi-perspective analysis (Reformed, Catholic, Orthodox, etc.)</li>
          <li>Adaptive complexity based on user knowledge level</li>
        </ul>
      </div>

      {/* Example Prompts */}
      <div className="mb-6">
        <h2 className="text-xl font-semibold mb-3">Example Prompts</h2>
        <div className="space-y-4">
          {examplePrompts.map((category, idx) => (
            <div key={idx} className="border rounded-lg p-4">
              <h3 className="font-semibold mb-2">{category.category}</h3>
              <div className="space-y-2">
                {category.prompts.map((prompt, pidx) => (
                  <button
                    key={pidx}
                    onClick={() => setMessage(prompt)}
                    className="block w-full text-left p-2 text-sm bg-gray-50 hover:bg-gray-100 rounded"
                  >
                    {prompt}
                  </button>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* Mode Selection */}
      <div className="mb-4">
        <label className="block text-sm font-medium mb-2">Mode</label>
        <div className="flex gap-4">
          <label className="flex items-center">
            <input
              type="radio"
              value="fast"
              checked={mode === 'fast'}
              onChange={(e) => setMode(e.target.value as 'fast' | 'accurate')}
              className="mr-2"
            />
            Fast Mode (Concise)
          </label>
          <label className="flex items-center">
            <input
              type="radio"
              value="accurate"
              checked={mode === 'accurate'}
              onChange={(e) => setMode(e.target.value as 'fast' | 'accurate')}
              className="mr-2"
            />
            Accurate Mode (Comprehensive)
          </label>
        </div>
      </div>

      {/* Message Input */}
      <div className="mb-4">
        <textarea
          value={message}
          onChange={(e) => setMessage(e.target.value)}
          placeholder="Ask a challenging theological, philosophical, or personal question..."
          className="w-full p-3 border rounded-lg"
          rows={4}
        />
        <button
          onClick={sendMessage}
          disabled={loading || !message.trim()}
          className="mt-2 px-6 py-2 bg-blue-600 text-white rounded-lg disabled:opacity-50"
        >
          {loading ? 'Processing...' : 'Send Message'}
        </button>
      </div>

      {/* Response */}
      {response && (
        <div className="mb-4">
          <h3 className="font-semibold mb-2">Response:</h3>
          <div className="p-4 bg-gray-50 rounded-lg whitespace-pre-wrap">
            {response}
          </div>
        </div>
      )}

      {/* Metadata */}
      {metadata && (
        <div className="mt-4 p-4 bg-green-50 rounded-lg">
          <h3 className="font-semibold mb-2">Response Metadata:</h3>
          <ul className="text-sm space-y-1">
            <li>Response Length: {metadata.responseLength} characters</li>
            <li>Duration: {metadata.duration}ms</li>
            <li>Scripture References: {metadata.scriptureCount}</li>
            <li>Topics: {metadata.topics?.join(', ') || 'N/A'}</li>
          </ul>
        </div>
      )}

      {!user && (
        <div className="mt-6 p-4 bg-yellow-50 rounded-lg">
          <p className="text-sm">Please sign in to test the enhanced chat features.</p>
        </div>
      )}
    </div>
  );
}
