// Enhanced Prompt Engineering for Shield AI v2.0
// Advanced context-aware prompting with deeper theological and philosophical integration

import { ObjectionAnalysis } from './objection-classifier';
import { advancedPrompts } from './advanced-prompts';

export interface EnhancedPromptContext {
  // Core context
  questionType: 'theological' | 'philosophical' | 'cultural' | 'personal' | 'general';
  userIntent: 'seeking' | 'challenging' | 'learning' | 'struggling' | 'curious';
  complexity: 'basic' | 'intermediate' | 'advanced';
  sessionLength: number;
  
  // Enhanced context
  emotionalTone: 'neutral' | 'positive' | 'negative' | 'anxious' | 'angry' | 'hopeful';
  theologicalPerspective: 'reformed' | 'evangelical' | 'catholic' | 'orthodox' | 'general';
  engagementLevel: 'surface' | 'moderate' | 'deep';
  previousTopics: string[];
  userKnowledgeLevel: 'beginner' | 'intermediate' | 'advanced' | 'scholar';
  conversationGoal: 'apologetics' | 'pastoral' | 'educational' | 'evangelistic' | 'discipleship';
}

export interface MemoryContext {
  keyTopics: string[];
  emotionalTone: string;
  userPreferences: {
    communicationStyle: 'formal' | 'casual' | 'academic' | 'pastoral';
    preferredTopics: string[];
    theologicalLeanings: string[];
    learningStyle: 'visual' | 'logical' | 'narrative' | 'practical';
  };
  conversationPatterns: {
    averageResponseLength: number;
    questionComplexity: 'simple' | 'moderate' | 'complex';
    engagementDepth: number; // 0-10 scale
  };
  spiritualJourney: {
    stage: 'seeking' | 'new_believer' | 'growing' | 'mature' | 'struggling';
    keyMilestones: string[];
    currentChallenges: string[];
  };
}

export const ENHANCED_BASE_PROMPT = `You are Shield AI, an advanced AI-powered apologetics companion with deep theological knowledge and pastoral wisdom. You embody the perfect balance of intellectual rigor and compassionate care.

## CORE IDENTITY
You are:
- A **Theological Scholar**: Deeply versed in Scripture, church history, and systematic theology
- A **Philosophical Thinker**: Trained in logic, epistemology, and philosophy of religion
- A **Cultural Apologist**: Understanding contemporary culture and its challenges to faith
- A **Pastoral Counselor**: Compassionate, empathetic, and skilled in spiritual care
- A **Faithful Teacher**: Committed to biblical truth while acknowledging mystery

## ADVANCED CAPABILITIES
1. **Contextual Understanding**: You remember and build upon previous conversations
2. **Adaptive Communication**: You adjust your style based on the user's needs and level
3. **Theological Precision**: You distinguish between essential doctrines and secondary issues
4. **Cultural Awareness**: You understand modern challenges and speak relevantly
5. **Spiritual Discernment**: You recognize when someone needs truth, comfort, or challenge

## RESPONSE FRAMEWORK 2.0
1. **Discern the Heart**: Understand not just what is asked, but why
2. **Meet Them Where They Are**: Adapt to their emotional and spiritual state
3. **Build Bridges**: Connect their question to deeper truths
4. **Provide Solid Ground**: Offer biblical and rational foundations
5. **Point Forward**: Give practical next steps for growth

## THEOLOGICAL FOUNDATIONS
- **Scripture**: The inspired, authoritative Word of God
- **Trinity**: One God in three persons - Father, Son, and Holy Spirit
- **Incarnation**: Jesus Christ, fully God and fully man
- **Atonement**: Salvation by grace through faith in Christ's work
- **Resurrection**: The historical, bodily resurrection of Jesus
- **Church**: The body of Christ, called to mission and witness
- **Eschatology**: The sure hope of Christ's return and eternal life

## COMMUNICATION PRINCIPLES
- **Grace and Truth**: Like Jesus, full of both (John 1:14)
- **Wisdom and Innocence**: Wise as serpents, innocent as doves (Matthew 10:16)
- **Gentleness and Respect**: Always ready with a reason (1 Peter 3:15)
- **Love and Logic**: Engaging both heart and mind
- **Humility and Confidence**: Sure of truth, humble in presentation

## ENHANCED FEATURES
- Reference relevant Scripture with proper exegesis
- Draw from 2000+ years of Christian thought
- Engage with contemporary scholarship
- Address real-world applications
- Provide resources for deeper study
- Remember and build on conversation history
- Adapt to user's spiritual journey stage`;

export function generateEnhancedPrompt(
  context: EnhancedPromptContext,
  objectionAnalysis: ObjectionAnalysis,
  memoryContext: MemoryContext | null,
  mode: 'fast' | 'accurate'
): string {
  let prompt = ENHANCED_BASE_PROMPT;

  // Add memory-based personalization
  if (memoryContext) {
    prompt += `

## CONVERSATION MEMORY
You have had previous conversations with this person about: ${memoryContext.keyTopics.join(', ')}.
Their emotional tone has been: ${memoryContext.emotionalTone}.
They prefer: ${memoryContext.userPreferences.communicationStyle} communication.
Their learning style is: ${memoryContext.userPreferences.learningStyle}.
They are at the "${memoryContext.spiritualJourney.stage}" stage of their spiritual journey.
Current challenges include: ${memoryContext.spiritualJourney.currentChallenges.join(', ')}.

IMPORTANT: Reference relevant past discussions naturally. Show that you remember them.`;
  }

  // Add sophisticated context analysis
  prompt += `

## CURRENT CONTEXT ANALYSIS
Question Type: ${context.questionType}
User Intent: ${context.userIntent}
Emotional Tone: ${context.emotionalTone}
Engagement Level: ${context.engagementLevel}
Knowledge Level: ${context.userKnowledgeLevel}
Conversation Goal: ${context.conversationGoal}

## OBJECTION ANALYSIS
Primary Type: ${objectionAnalysis.primaryType}
Intensity: ${objectionAnalysis.intensity}
User Stance: ${objectionAnalysis.userStance}
Key Themes: ${objectionAnalysis.keyThemes.join(', ')}
Response Strategy: ${objectionAnalysis.responseStrategy}`;

  // Add specialized guidance based on conversation goal
  switch (context.conversationGoal) {
    case 'apologetics':
      prompt += `

## APOLOGETICS GUIDANCE
- Present clear, logical arguments
- Address specific objections with evidence
- Use philosophical reasoning appropriately
- Reference respected apologists and scholars
- Acknowledge the strength of their questions
- Build a cumulative case for Christianity`;
      break;

    case 'pastoral':
      prompt += `

## PASTORAL GUIDANCE
- Prioritize empathy and understanding
- Address emotional and spiritual needs
- Provide biblical comfort and hope
- Suggest practical spiritual disciplines
- Connect them with community resources
- Minister to their specific situation`;
      break;

    case 'educational':
      prompt += `

## EDUCATIONAL GUIDANCE
- Teach systematically and clearly
- Build on their current knowledge
- Use appropriate theological terms
- Provide helpful analogies and examples
- Suggest resources for further study
- Check for understanding`;
      break;

    case 'evangelistic':
      prompt += `

## EVANGELISTIC GUIDANCE
- Share the gospel clearly and winsomely
- Address barriers to faith sensitively
- Use personal stories and testimonies
- Invite response without pressure
- Focus on Christ's love and work
- Pray for the Holy Spirit's work`;
      break;

    case 'discipleship':
      prompt += `

## DISCIPLESHIP GUIDANCE
- Focus on spiritual growth and maturity
- Teach practical application of Scripture
- Encourage spiritual disciplines
- Address areas of struggle honestly
- Celebrate growth and progress
- Challenge toward deeper commitment`;
      break;
  }

  // Add mode-specific instructions
  if (mode === 'accurate') {
    prompt += `

## ACCURATE MODE INSTRUCTIONS
- Provide comprehensive, nuanced responses
- Include multiple perspectives when relevant
- Reference specific scholars and sources
- Develop arguments thoroughly
- Address potential counter-arguments
- Suggested length: 4-6 substantial paragraphs`;
  } else {
    prompt += `

## FAST MODE INSTRUCTIONS
- Provide concise, focused responses
- Address the core issue directly
- Use clear, accessible language
- Include key Scripture references
- Offer one or two main insights
- Suggested length: 2-3 focused paragraphs`;
  }

  // Add theological perspective guidance
  if (context.theologicalPerspective !== 'general') {
    prompt += `

## THEOLOGICAL PERSPECTIVE
The user appears to have ${context.theologicalPerspective} leanings. While maintaining biblical fidelity:
- Acknowledge their tradition respectfully
- Use familiar theological language
- Reference respected figures from their tradition
- Build bridges while maintaining truth`;
  }

  return prompt;
}

export function generateContextualResponse(
  analysis: ObjectionAnalysis,
  context: EnhancedPromptContext
): string {
  // Generate a template response based on deep analysis
  const templates = {
    'seeker-theological': `I appreciate your sincere question about [topic]. This is something many thoughtful people wrestle with as they explore faith.

From a biblical perspective, [key Scripture and explanation]. This shows us that [theological insight].

What I find particularly meaningful is [personal/practical connection]. Throughout church history, Christians have understood this to mean [historical perspective].

[Address potential concerns or objections]

Would you like to explore [specific aspect] further? I'm here to help you think through these important questions.`,

    'skeptic-philosophical': `That's an excellent philosophical question that deserves a thoughtful response. You're right to think critically about these matters.

Let me address your concern from several angles:

First, from a logical perspective, [philosophical argument]. This has been developed by thinkers like [relevant philosophers].

Second, the evidence suggests [evidential support]. We can see this in [specific examples].

Third, consider the implications: [practical/existential considerations].

Many have found that [bridge to faith]. What aspects of this would you like to examine more closely?`,

    'struggler-personal': `I hear the pain in your question, and I want you to know that what you're feeling is valid and important. You're not alone in this struggle.

The Scriptures speak directly to this: [comforting Scripture]. God understands our struggles more than we often realize.

In my experience helping others through similar challenges, I've seen how [practical encouragement]. 

Here are some steps that might help: [specific, actionable guidance].

Remember, [gospel hope and encouragement]. How can I best support you in this journey?`,

    'believer-growth': `That's a wonderful question for deepening your faith! It shows you're thinking seriously about what you believe.

Theologically, [doctrinal explanation]. This connects to the broader biblical theme of [systematic theology connection].

Historically, the church has understood this through [church history insight]. Great theologians like [relevant theologians] have contributed [specific insights].

For practical application, [spiritual disciplines or practices]. This can transform how we [life application].

What other aspects of this doctrine would you like to explore? There's always more depth to discover!`,
  };

  // Select appropriate template
  const key = `${analysis.userStance}-${context.questionType}`;
  return (templates as any)[key] || templates['seeker-theological'];
}

export const enhancedResponseModifiers = {
  addScholarlyDepth: (response: string, scholars: string[]): string => {
    const scholarSection = `

**Scholarly Perspectives:**
${scholars.map(scholar => `- ${scholar}`).join('\n')}`;
    return response + scholarSection;
  },

  addPastoralCare: (response: string): string => {
    return response + `

**A Personal Word:**
I want you to know that I'm praying for you as you work through these questions. God sees you, knows you, and loves you deeply. Whatever you're facing, you don't have to face it alone.`;
  },

  addApologeticResources: (response: string, resources: string[]): string => {
    return response + `

**Recommended Resources:**
${resources.map(resource => `- ${resource}`).join('\n')}`;
  },

  addConversationContinuation: (response: string, topics: string[]): string => {
    return response + `

**Continue the Conversation:**
Based on our discussion, you might also be interested in exploring:
${topics.map((topic, i) => `${i + 1}. ${topic}`).join('\n')}

Which of these would you like to discuss next?`;
  },

  addScriptureChain: (response: string, verses: Array<{reference: string, relevance: string}>): string => {
    const verseSection = `

**Scripture Study Chain:**
${verses.map(v => `- **${v.reference}**: ${v.relevance}`).join('\n')}`;
    return response + verseSection;
  }
};

// Enhanced conversation memory builder
export function buildEnhancedMemoryContext(
  previousMessages: Array<{content: string; role: string; timestamp?: Date}>,
  userProfile?: any
): MemoryContext {
  // Analyze conversation patterns
  const topics = extractKeyTopics(previousMessages);
  const tone = analyzeEmotionalTone(previousMessages);
  const patterns = analyzeConversationPatterns(previousMessages);
  
  return {
    keyTopics: topics,
    emotionalTone: tone,
    userPreferences: {
      communicationStyle: detectCommunicationStyle(previousMessages),
      preferredTopics: topics.slice(0, 5),
      theologicalLeanings: detectTheologicalLeanings(previousMessages),
      learningStyle: detectLearningStyle(previousMessages)
    },
    conversationPatterns: patterns,
    spiritualJourney: {
      stage: detectSpiritualStage(previousMessages),
      keyMilestones: extractMilestones(previousMessages),
      currentChallenges: extractChallenges(previousMessages)
    }
  };
}

// Helper functions for memory analysis
function extractKeyTopics(messages: Array<{content: string; role: string}>): string[] {
  const topics = new Map<string, number>();
  const topicKeywords = {
    'salvation': ['salvation', 'saved', 'born again', 'redemption', 'grace'],
    'trinity': ['trinity', 'father', 'son', 'holy spirit', 'godhead'],
    'prayer': ['prayer', 'pray', 'praying', 'intercession', 'petition'],
    'suffering': ['suffering', 'pain', 'evil', 'hardship', 'trials'],
    'scripture': ['bible', 'scripture', 'word of god', 'biblical', 'verse'],
    'church': ['church', 'fellowship', 'community', 'body of christ'],
    'evangelism': ['evangelism', 'witness', 'sharing faith', 'gospel', 'good news'],
    'discipleship': ['discipleship', 'growth', 'maturity', 'sanctification']
  };

  messages.forEach(msg => {
    const content = msg.content.toLowerCase();
    Object.entries(topicKeywords).forEach(([topic, keywords]) => {
      if (keywords.some(keyword => content.includes(keyword))) {
        topics.set(topic, (topics.get(topic) || 0) + 1);
      }
    });
  });

  return Array.from(topics.entries())
    .sort((a, b) => b[1] - a[1])
    .map(([topic]) => topic);
}

function analyzeEmotionalTone(messages: Array<{content: string; role: string}>): string {
  const userMessages = messages.filter(m => m.role === 'user');
  let positiveCount = 0;
  let negativeCount = 0;
  let neutralCount = 0;

  const positiveWords = ['thank', 'grateful', 'blessed', 'joy', 'peace', 'hope', 'love', 'excited'];
  const negativeWords = ['angry', 'frustrated', 'confused', 'hurt', 'pain', 'doubt', 'fear', 'worried'];

  userMessages.forEach(msg => {
    const content = msg.content.toLowerCase();
    const hasPositive = positiveWords.some(word => content.includes(word));
    const hasNegative = negativeWords.some(word => content.includes(word));
    
    if (hasPositive && !hasNegative) positiveCount++;
    else if (hasNegative && !hasPositive) negativeCount++;
    else neutralCount++;
  });

  if (positiveCount > negativeCount * 2) return 'positive';
  if (negativeCount > positiveCount * 2) return 'negative';
  return 'mixed';
}

function detectCommunicationStyle(messages: Array<{content: string; role: string}>): 'formal' | 'casual' | 'academic' | 'pastoral' {
  const userMessages = messages.filter(m => m.role === 'user').map(m => m.content);
  const avgLength = userMessages.reduce((sum, msg) => sum + msg.length, 0) / userMessages.length;
  
  // Check for academic indicators
  const academicWords = ['theology', 'philosophy', 'doctrine', 'systematic', 'hermeneutics', 'exegesis'];
  const hasAcademic = userMessages.some(msg => 
    academicWords.some(word => msg.toLowerCase().includes(word))
  );
  
  // Check for casual indicators
  const casualIndicators = ["I'm", "won't", "can't", "don't", "!", "?", "..."];
  const hasCasual = userMessages.some(msg => 
    casualIndicators.some(indicator => msg.includes(indicator))
  );
  
  if (hasAcademic && avgLength > 100) return 'academic';
  if (hasCasual && avgLength < 50) return 'casual';
  if (avgLength > 80) return 'formal';
  return 'pastoral';
}

function detectTheologicalLeanings(messages: Array<{content: string; role: string}>): string[] {
  const leanings = [];
  const indicators = {
    'reformed': ['sovereignty', 'election', 'predestination', 'calvin', 'reformed'],
    'charismatic': ['gifts', 'tongues', 'healing', 'prophecy', 'spirit-filled'],
    'liturgical': ['liturgy', 'tradition', 'church fathers', 'sacraments', 'eucharist'],
    'evangelical': ['personal relationship', 'born again', 'quiet time', 'devotions']
  };

  const content = messages.map(m => m.content.toLowerCase()).join(' ');
  Object.entries(indicators).forEach(([leaning, keywords]) => {
    if (keywords.some(keyword => content.includes(keyword))) {
      leanings.push(leaning);
    }
  });

  return leanings;
}

function detectLearningStyle(messages: Array<{content: string; role: string}>): 'visual' | 'logical' | 'narrative' | 'practical' {
  const userMessages = messages.filter(m => m.role === 'user').map(m => m.content.toLowerCase());
  
  const styleIndicators = {
    visual: ['see', 'show', 'picture', 'imagine', 'look'],
    logical: ['why', 'how', 'prove', 'evidence', 'reason', 'logic'],
    narrative: ['story', 'example', 'testimony', 'experience', 'tell me about'],
    practical: ['how to', 'what should', 'apply', 'practice', 'do']
  };

  const scores = { visual: 0, logical: 0, narrative: 0, practical: 0 };
  
  userMessages.forEach(msg => {
    Object.entries(styleIndicators).forEach(([style, indicators]) => {
      indicators.forEach(indicator => {
        if (msg.includes(indicator)) {
          scores[style]++;
        }
      });
    });
  });

  return Object.entries(scores)
    .sort((a, b) => b[1] - a[1])[0][0] as any;
}

function analyzeConversationPatterns(messages: Array<{content: string; role: string}>): any {
  const userMessages = messages.filter(m => m.role === 'user');
  const avgLength = userMessages.reduce((sum, msg) => sum + msg.content.length, 0) / userMessages.length;
  
  // Analyze question complexity
  const complexIndicators = ['why', 'how', 'explain', 'understand', 'meaning'];
  const complexCount = userMessages.filter(msg => 
    complexIndicators.some(indicator => msg.content.toLowerCase().includes(indicator))
  ).length;
  
  const complexityRatio = complexCount / userMessages.length;
  let complexity: 'simple' | 'moderate' | 'complex' = 'simple';
  if (complexityRatio > 0.6) complexity = 'complex';
  else if (complexityRatio > 0.3) complexity = 'moderate';

  // Calculate engagement depth (0-10)
  const engagementFactors = {
    avgLength: Math.min(avgLength / 100, 3), // Max 3 points
    complexity: complexity === 'complex' ? 3 : complexity === 'moderate' ? 2 : 1, // Max 3 points
    topicDepth: Math.min(messages.length / 10, 2), // Max 2 points
    personalSharing: userMessages.filter(m => m.content.includes('I ') || m.content.includes('my ')).length > 3 ? 2 : 1 // Max 2 points
  };

  const engagementDepth = Object.values(engagementFactors).reduce((sum, val) => sum + val, 0);

  return {
    averageResponseLength: avgLength,
    questionComplexity: complexity,
    engagementDepth: Math.round(engagementDepth)
  };
}

function detectSpiritualStage(messages: Array<{content: string; role: string}>): string {
  const content = messages.map(m => m.content.toLowerCase()).join(' ');
  
  const stageIndicators = {
    seeking: ['searching', 'exploring', 'curious', 'interested', 'agnostic', 'atheist'],
    new_believer: ['new christian', 'just accepted', 'recently saved', 'baby christian', 'new faith'],
    growing: ['growing', 'learning', 'understanding', 'deeper', 'want to know more'],
    mature: ['ministry', 'teaching', 'leading', 'discipling', 'years of faith'],
    struggling: ['doubting', 'questioning', 'struggling', 'falling away', 'backsliding']
  };

  for (const [stage, indicators] of Object.entries(stageIndicators)) {
    if (indicators.some(indicator => content.includes(indicator))) {
      return stage;
    }
  }

  return 'growing'; // Default
}

function extractMilestones(messages: Array<{content: string; role: string}>): string[] {
  const milestones = [];
  const milestoneIndicators = {
    'accepted Christ': ['accepted christ', 'gave my life', 'became a christian'],
    'baptized': ['baptized', 'baptism'],
    'joined church': ['joined church', 'found a church', 'church member'],
    'started serving': ['serving', 'ministry', 'volunteer'],
    'overcame struggle': ['overcame', 'victory over', 'freed from']
  };

  const content = messages.map(m => m.content.toLowerCase()).join(' ');
  
  Object.entries(milestoneIndicators).forEach(([milestone, indicators]) => {
    if (indicators.some(indicator => content.includes(indicator))) {
      milestones.push(milestone);
    }
  });

  return milestones;
}

function extractChallenges(messages: Array<{content: string; role: string}>): string[] {
  const challenges = [];
  const challengeIndicators = {
    'doubt': ['doubt', 'questioning', 'unsure'],
    'sin patterns': ['struggling with', 'can\'t stop', 'addiction', 'temptation'],
    'relationships': ['marriage', 'dating', 'family issues', 'conflict'],
    'spiritual dryness': ['dry', 'distant from god', 'can\'t pray', 'lost faith'],
    'suffering': ['pain', 'loss', 'grief', 'why me']
  };

  const content = messages.map(m => m.content.toLowerCase()).join(' ');
  
  Object.entries(challengeIndicators).forEach(([challenge, indicators]) => {
    if (indicators.some(indicator => content.includes(indicator))) {
      challenges.push(challenge);
    }
  });

  return challenges;
}
