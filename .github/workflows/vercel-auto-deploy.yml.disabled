name: 🚀 Vercel Auto-Deploy & Domain Sync

on:
  push:
    branches: [ main, ios-app, dev, prod, staging ]
  pull_request:
    branches: [ main, ios-app ]
  workflow_dispatch:
    inputs:
      branch:
        description: 'Branch to deploy'
        required: true
        default: 'ios-app'
        type: choice
        options:
          - ios-app
          - main
          - dev
          - prod
          - staging

env:
  VERCEL_ORG_ID: ${{ secrets.VERCEL_ORG_ID }}
  VERCEL_PROJECT_ID: ${{ secrets.VERCEL_PROJECT_ID }}

jobs:
  # ============================================
  # 🧪 TEST & BUILD JOB
  # ============================================
  test-and-build:
    name: 🧪 Test & Build
    runs-on: ubuntu-latest
    steps:
      - name: 📥 Checkout code
        uses: actions/checkout@v4

      - name: 📦 Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '18'
          cache: 'npm'

      - name: 📦 Install dependencies
        run: npm ci

      - name: 🧪 Run tests
        run: npm run test:ci || echo "No tests configured"

      - name: 🔍 Lint code
        run: npm run lint || echo "No linting configured"

      - name: 🏗️ Build project
        run: npm run build:web

  # ============================================
  # 🚀 DEPLOYMENT JOB
  # ============================================
  deploy:
    name: 🚀 Deploy to Vercel
    runs-on: ubuntu-latest
    needs: test-and-build
    environment:
      name: production
      url: https://shieldai.cloud
    steps:
      - name: 📥 Checkout code
        uses: actions/checkout@v4

      - name: 📦 Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '18'
          cache: 'npm'

      - name: 📦 Install Vercel CLI
        run: npm install -g vercel@latest

      - name: 🔄 Pull Vercel Environment
        run: vercel pull --yes --environment=production --token=${{ secrets.VERCEL_TOKEN }}

      - name: 🏗️ Build Project
        run: vercel build --prod --token=${{ secrets.VERCEL_TOKEN }}

      - name: 🚀 Deploy to Vercel
        id: deploy
        run: |
          vercel deploy --prebuilt --prod --token=${{ secrets.VERCEL_TOKEN }} > deployment-url.txt
          echo "deployment_url=$(cat deployment-url.txt)" >> $GITHUB_OUTPUT
          echo "deployment_url=$(cat deployment-url.txt)"

      - name: 🔍 Wait for deployment
        run: |
          echo "Waiting for deployment to be ready..."
          sleep 30

  # ============================================
  # 🔗 DOMAIN SYNC JOB
  # ============================================
  sync-domain:
    name: 🔗 Sync Custom Domain
    runs-on: ubuntu-latest
    needs: deploy
    if: github.ref == 'refs/heads/ios-app' || github.ref == 'refs/heads/main' || github.event.inputs.branch == 'ios-app' || github.event.inputs.branch == 'main'
    steps:
      - name: 📦 Install Vercel CLI
        run: npm install -g vercel@latest

      - name: 🔄 Sync Domain to Latest Deployment
        run: |
          echo "🔄 Syncing shieldai.cloud to latest production deployment..."
          
          # Get the latest production deployment
          LATEST_DEPLOYMENT=$(vercel ls --token=${{ secrets.VERCEL_TOKEN }} | grep "Production" | grep -v "Deployments" | head -1 | awk '{print $3}')
          
          if [ -n "$LATEST_DEPLOYMENT" ]; then
            echo "✅ Latest production deployment: $LATEST_DEPLOYMENT"
            
            # Update domain alias
            vercel alias "$LATEST_DEPLOYMENT" shieldai.cloud --token=${{ secrets.VERCEL_TOKEN }}
            
            echo "✅ Domain synced successfully"
          else
            echo "❌ No production deployment found"
            exit 1
          fi
        env:
          VERCEL_TOKEN: ${{ secrets.VERCEL_TOKEN }}

      - name: 🔍 Verify Domain Sync
        run: |
          echo "🔍 Verifying domain sync..."
          sleep 30
          
          # Check if domain is pointing to latest deployment
          CURRENT_ALIAS=$(vercel inspect shieldai.cloud --token=${{ secrets.VERCEL_TOKEN }} 2>/dev/null | grep "url" | awk '{print $2}' || echo "none")
          LATEST_DEPLOYMENT=$(vercel ls --token=${{ secrets.VERCEL_TOKEN }} | grep "Production" | grep -v "Deployments" | head -1 | awk '{print $3}')
          
          if [ "$CURRENT_ALIAS" = "$LATEST_DEPLOYMENT" ]; then
            echo "✅ Domain sync verified successfully"
            echo "🌐 shieldai.cloud now points to: $LATEST_DEPLOYMENT"
          else
            echo "❌ Domain sync verification failed"
            echo "Expected: $LATEST_DEPLOYMENT"
            echo "Got: $CURRENT_ALIAS"
            exit 1
          fi
        env:
          VERCEL_TOKEN: ${{ secrets.VERCEL_TOKEN }}

      - name: 🔍 Health Check
        run: |
          echo "🔍 Running health check on shieldai.cloud..."
          sleep 60  # Wait for DNS propagation
          
          # Test the main API endpoint
          curl -f https://shieldai.cloud/api/health || echo "Health check failed, but deployment may still be working"
          
          echo "✅ Domain sync and health check complete!"

  # ============================================
  # 📢 NOTIFICATION JOB
  # ============================================
  notify:
    name: 📢 Deployment Notification
    runs-on: ubuntu-latest
    needs: [deploy, sync-domain]
    if: always()
    steps:
      - name: 📢 Deployment Status
        run: |
          if [ "${{ needs.deploy.result }}" == "success" ] && [ "${{ needs.sync-domain.result }}" == "success" ]; then
            echo "🎉 SUCCESS: Deployment and domain sync completed!"
            echo "🌐 Production URL: https://shieldai.cloud"
            echo "🔗 Deployment URL: ${{ needs.deploy.outputs.deployment_url }}"
          elif [ "${{ needs.deploy.result }}" == "success" ]; then
            echo "⚠️ PARTIAL SUCCESS: Deployment completed but domain sync failed"
            echo "🌐 Production URL: https://shieldai.cloud"
            echo "🔗 Deployment URL: ${{ needs.deploy.outputs.deployment_url }}"
          else
            echo "❌ FAILURE: Deployment failed"
            exit 1
          fi

      - name: 🔗 Comment on PR (if applicable)
        if: github.event_name == 'pull_request'
        uses: actions/github-script@v7
        with:
          script: |
            const status = '${{ needs.deploy.result }}' === 'success' && '${{ needs.sync-domain.result }}' === 'success' ? '✅' : '⚠️';
            const message = status === '✅' 
              ? `🚀 **Deployment Successful!**\n\n🌐 **Production URL:** https://shieldai.cloud\n🔗 **Deployment:** ${{ needs.deploy.outputs.deployment_url }}\n\n✅ Domain synced and ready!`
              : `⚠️ **Deployment Completed with Issues**\n\n🌐 **Production URL:** https://shieldai.cloud\n🔗 **Deployment:** ${{ needs.deploy.outputs.deployment_url }}\n\n⚠️ Domain sync may have failed. Please check the logs.`;
            
            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: message
            });
