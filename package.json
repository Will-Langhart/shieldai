{
  "name": "shieldai",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "apps/mobile"
  ],
  "packageManager": "npm@10",
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "dev:web:logging": "./scripts/dev-with-logging.sh",
    "build:web": "npm run build --workspace apps/web",
    "start:web": "npm run start --workspace apps/web",
    "lint:web": "npm run lint --workspace apps/web",
    "dev:frontend": "npm run dev --workspace apps/frontend",
    "build:frontend": "npm run build --workspace apps/frontend",
    "preview:frontend": "npm run preview --workspace apps/frontend",
    "lint:frontend": "npm run lint --workspace apps/frontend",
    "dev:mobile": "npm run start --workspace apps/mobile || (echo 'Mobile app not yet created' && exit 0)",
    "dev:backend": "python app.py",
    "start:backend": "gunicorn -c gunicorn.conf.py app:app",
    "install:backend": "pip install -r requirements.txt",
    "favicon": "node scripts/generate-favicon.js",
    "sync-domain": "./scripts/sync-vercel-domain.sh",
    "deploy": "vercel --prod && npm run sync-domain",
    "configure-vercel": "./scripts/configure-vercel.sh",
    "setup-vercel": "./scripts/setup-vercel-git-integration.sh",
    "deploy-auto": "vercel --prod && npm run sync-domain",
    "deploy-branch": "vercel --prod --yes && npm run sync-domain",
    "postinstall": "echo Monorepo bootstrap complete"
  },
  "devDependencies": {
    "sharp": "^0.33.0"
  }
}
