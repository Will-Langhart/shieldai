{
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "composite": false,
    "rootDir": "src",
    "module": "ESNext",
    "target": "ES2019",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "strict": true,
    "lib": ["ES2020"],
    "types": []
  },
  "include": ["src/**/*"]
}


