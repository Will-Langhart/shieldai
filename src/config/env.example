# Shield AI - Environment Variables
# Copy this file to .env.local and fill in your actual API keys

# Anthropic (Claude) — text GENERATION (chat, specialists, synthesizer, Bible AI).
# Tiered model mapping is env-overridable; defaults: Haiku specialists → Sonnet
# gentle → Opus scholarly/debate. See lib/llm.ts.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# CLAUDE_SPECIALIST_MODEL=claude-haiku-4-5
# CLAUDE_GENTLE_MODEL=claude-sonnet-5
# CLAUDE_DEEP_MODEL=claude-opus-5

# OpenAI Configuration — now only EMBEDDINGS (Pinecone memory index) and image
# generation (DALL·E). Claude has no embeddings/image API, so this key stays.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# LangSmith Observability (Phase 1 — traces the LangGraph apologetics pipeline)
# When LANGSMITH_TRACING=true, the Claude client (lib/llm.ts) and the OpenAI client
# (lib/observability/openai-traced.ts) are wrapped so every generation/embedding call
# becomes a nested span under the graph run.
# Leave tracing unset/false to disable (zero behavior change). Project defaults to
# "langgraph-rag" if LANGSMITH_PROJECT is omitted.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=langgraph-rag
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com   # override for EU / self-hosted

# Pinecone Vector Database
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=shieldai
PINECONE_DIMENSION=1024
PINECONE_TOPK=8
PINECONE_MIN_SIMILARITY=0.18
PINECONE_BATCH_SIZE=50
PINECONE_MAX_RETRIES=3
PINECONE_BACKOFF_MS=300

# RAG retrieval tuning (architecture pass — all optional, off by default)
# Reranking: retrieve RERANK_POOL candidates then let Pinecone's hosted reranker
# reorder to the requested topK. Applies to bible-verses + apologetics-kb searches.
RERANK_ENABLED=false
RERANK_MODEL=bge-reranker-v2-m3
RERANK_POOL=20
# Query rewriting: history-aware condense + objection→query expansion (Haiku) before
# retrieval. Improves multi-turn recall; falls back to the raw message on failure.
QUERY_REWRITE_ENABLED=false
# Hybrid Bible retrieval: fuse dense (bible-verses) + sparse (bible-verses-sparse)
# with RRF for exact-phrase / reference lookups. Requires creating + populating a
# sparse index (see lib/bible-sparse-index.ts header); degrades to dense until then.
HYBRID_BIBLE_ENABLED=false
BIBLE_SPARSE_INDEX=bible-verses-sparse
HYBRID_POOL=20
HYBRID_RRF_K=60

# Database Configuration (PostgreSQL/Supabase)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.yyfhspfqncogzitfpfbw.supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Google Places API (for church finder)
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=your_google_places_api_key
# Server-only key used by API routes (preferred over NEXT_PUBLIC_* on server)
GOOGLE_PLACES_SERVER_API_KEY=your_google_places_server_api_key

# Bible API Configuration
BIBLE_API_KEY=your_bible_api_key_here
BIBLE_API_BASE_URL=https://api.scripture.api.bible/v1

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3001
NODE_ENV=development

# Security
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# PWA & Push Notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here 
# langeval tracing (optional)
# Both must be set or nothing is sent — the app runs untouched without them.
# The key is a langeval project API key with the `ingest` scope.
LANGEVAL_OTLP_ENDPOINT=https://your-langeval-host/otlp/v1/traces
LANGEVAL_API_KEY=lge_your_ingest_key
LANGEVAL_SERVICE_NAME=shieldai-web
