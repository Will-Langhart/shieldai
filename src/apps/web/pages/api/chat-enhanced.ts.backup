import { NextApiRequest, NextApiResponse } from 'next';
import { OpenAI } from 'openai';
import { Stream } from 'openai/streaming';
import { ChatService } from '../../lib/chat-service';
import { createServerSupabaseClient } from '../../lib/supabase';
import { v4 as uuidv4 } from 'uuid';
import { MemoryService } from '../../lib/memory-service';
import { AnalyticsService } from '../../lib/analytics-service';
import { logger } from '../../lib/logger';
import { SubscriptionMiddleware } from '../../lib/subscription-middleware';
import { 
  generateEnhancedPrompt, 
  buildEnhancedMemoryContext,
  enhancedResponseModifiers,
  generateContextualResponse,
  EnhancedPromptContext,
  ENHANCED_BASE_PROMPT
} from '../../lib/enhanced-prompt-engineering';
import { classifyObjection, ObjectionAnalysis } from '../../lib/objection-classifier';
import { advancedPrompts } from '../../lib/advanced-prompts';
import { bibleService } from '../../lib/bible-service';
import { searchApologeticsContent } from '../../lib/apologetics-knowledge';

const openai = new OpenAI({
  apiKey: process.env.OPENAI_API_KEY!,
});

// Enhanced memory store with richer context
const enhancedConversationStore = new Map<string, Array<{
  role: 'user' | 'assistant';
  content: string;
  metadata?: {
    timestamp: Date;
    emotionalTone?: string;
    topics?: string[];
    intent?: string;
  };
}>>();

export default async function handler(
  req: NextApiRequest,
  res: NextApiResponse
) {
  const cid = `cid_${Date.now()}_${Math.random().toString(36).substring(2, 9)}`;
  
  if (req.method !== 'POST') {
    logger.warn('Invalid method', { cid, method: req.method });
    return res.status(405).json({ error: 'Method not allowed' });
  }

  const { message, mode = 'fast', sessionId, conversationId } = req.body;

  if (!message) {
    logger.warn('Missing message', { cid });
    return res.status(400).json({ error: 'Message is required' });
  }

  // Enhanced session ID generation
  const enhancedSessionId = sessionId || `session_${Date.now()}_${uuidv4().substring(0, 8)}`;
  logger.info('Enhanced chat request', { cid, mode, sessionId: enhancedSessionId, conversationId });

  // Set streaming headers
  res.setHeader('Content-Type', 'text/event-stream');
  res.setHeader('Cache-Control', 'no-cache, no-transform');
  res.setHeader('Connection', 'keep-alive');
  res.setHeader('X-Correlation-ID', cid);

  const serverSupabase = createServerSupabaseClient(req, res);
  const { data: { user } } = await serverSupabase.auth.getUser();
  
  if (!user) {
    logger.warn('Unauthorized access attempt', { cid });
    res.write(`data: ${JSON.stringify({ error: 'Authentication required' })}\n\n`);
    return res.end();
  }

  try {
    // Enhanced feature access check with detailed logging
    const featureAccess = await SubscriptionMiddleware.checkApiFeatureAccess(
      user.id, 
      mode === 'accurate' ? 'accurate_mode' : 'fast_mode'
    );
    
    logger.info('Feature access check', { cid, mode, allowed: featureAccess.allowed });

    if (!featureAccess.allowed) {
      const errorMessage = {
        error: 'Feature not available',
        upgrade_required: true,
        current_tier: featureAccess.current_tier,
        required_tier: featureAccess.required_tier,
        remaining: featureAccess.remaining,
        limit: featureAccess.limit
      };
      res.write(`data: ${JSON.stringify(errorMessage)}\n\n`);
      return res.end();
    }

    // Get enhanced conversation history
    let conversationHistory = enhancedConversationStore.get(enhancedSessionId) || [];
    
    // Advanced context analysis
    const objectionAnalysis = classifyObjection(message);
    const enhancedContext: EnhancedPromptContext = analyzeEnhancedContext(message, conversationHistory);
    
    logger.info('Enhanced context analysis', { 
      cid, 
      questionType: enhancedContext.questionType,
      emotionalTone: enhancedContext.emotionalTone,
      engagementLevel: enhancedContext.engagementLevel,
      conversationGoal: enhancedContext.conversationGoal
    });

    // Build comprehensive memory context
    const memoryContext = await buildComprehensiveMemoryContext(
      user.id, 
      conversationId, 
      message, 
      conversationHistory,
      serverSupabase
    );

    // Generate highly specialized prompt
    const systemPrompt = generateEnhancedPrompt(
      enhancedContext,
      objectionAnalysis,
      memoryContext,
      mode
    );

    // Advanced model selection based on complexity and subscription
    const modelConfig = await selectOptimalModel(
      mode, 
      enhancedContext.complexity,
      objectionAnalysis.intensity,
      user.id
    );

    logger.info('Model configuration', { cid, ...modelConfig });

    // Build message array with rich context
    const messages = buildEnhancedMessageArray(
      systemPrompt,
      conversationHistory,
      message,
      memoryContext,
      objectionAnalysis
    );

    // Create streaming response with enhanced handling
    const stream = await openai.chat.completions.create({
      model: modelConfig.model,
      messages,
      temperature: modelConfig.temperature,
      max_tokens: modelConfig.maxTokens,
      stream: true,
      presence_penalty: 0.1,
      frequency_penalty: 0.1,
    });

    // Enhanced streaming with metadata
    let fullResponse = '';
    let responseMetadata = {
      startTime: Date.now(),
      tokenCount: 0,
      topics: [] as string[],
      scriptureReferences: [] as string[],
    };

    for await (const chunk of stream) {
      const content = chunk.choices[0]?.delta?.content;
      if (content) {
        fullResponse += content;
        responseMetadata.tokenCount++;
        
        // Extract scripture references in real-time
        const scripturePattern = /([1-3]?\s*[A-Za-z]+)\s+(\d+):(\d+(?:-\d+)?)/g;
        const matches = content.match(scripturePattern);
        if (matches) {
          responseMetadata.scriptureReferences.push(...matches);
        }
        
        res.write(`data: ${JSON.stringify({ 
          content,
          metadata: {
            elapsed: Date.now() - responseMetadata.startTime,
            tokensSoFar: responseMetadata.tokenCount
          }
        })}\n\n`);
      }
    }

    // Post-process response with enhancements
    const enhancedResponse = await postProcessResponse(
      fullResponse,
      enhancedContext,
      objectionAnalysis,
      responseMetadata
    );

    // Store enhanced conversation with metadata
    conversationHistory.push(
      { 
        role: 'user', 
        content: message,
        metadata: {
          timestamp: new Date(),
          emotionalTone: enhancedContext.emotionalTone,
          topics: objectionAnalysis.keyThemes,
          intent: enhancedContext.userIntent
        }
      },
      { 
        role: 'assistant', 
        content: fullResponse,
        metadata: {
          timestamp: new Date(),
          topics: responseMetadata.topics,
          scriptureReferences: responseMetadata.scriptureReferences
        }
      }
    );

    // Maintain optimal conversation history size
    if (conversationHistory.length > 20) {
      conversationHistory = preserveImportantContext(conversationHistory);
    }

    enhancedConversationStore.set(enhancedSessionId, conversationHistory);

    // Enhanced analytics tracking
    await trackEnhancedAnalytics(
      user.id,
      message,
      fullResponse,
      enhancedContext,
      objectionAnalysis,
      responseMetadata,
      cid
    );

    // Store in database with enhanced metadata
    if (conversationId) {
      await storeEnhancedConversation(
        conversationId,
        message,
        fullResponse,
        enhancedContext,
        objectionAnalysis,
        user.id,
        serverSupabase
      );
    }

    // Send completion signal with summary
    res.write(`data: ${JSON.stringify({ 
      done: true,
      summary: {
        responseLength: fullResponse.length,
        duration: Date.now() - responseMetadata.startTime,
        topics: responseMetadata.topics,
        scriptureCount: responseMetadata.scriptureReferences.length
      }
    })}\n\n`);
    
    res.end();

  } catch (error: any) {
    logger.error('Enhanced chat error', { cid, error: error.message });
    res.write(`data: ${JSON.stringify({ 
      error: 'An error occurred while processing your request',
      details: error.message 
    })}\n\n`);
    res.end();
  }
}

// Enhanced context analysis function
function analyzeEnhancedContext(
  message: string, 
  history: Array<any>
): EnhancedPromptContext {
  const lowerMessage = message.toLowerCase();
  
  // Determine emotional tone
  let emotionalTone: EnhancedPromptContext['emotionalTone'] = 'neutral';
  if (lowerMessage.includes('angry') || lowerMessage.includes('frustrated') || lowerMessage.includes('hate')) {
    emotionalTone = 'angry';
  } else if (lowerMessage.includes('worried') || lowerMessage.includes('anxious') || lowerMessage.includes('scared')) {
    emotionalTone = 'anxious';
  } else if (lowerMessage.includes('hope') || lowerMessage.includes('joy') || lowerMessage.includes('grateful')) {
    emotionalTone = 'hopeful';
  } else if (lowerMessage.includes('sad') || lowerMessage.includes('depressed') || lowerMessage.includes('hurt')) {
    emotionalTone = 'negative';
  }

  // Determine conversation goal
  let conversationGoal: EnhancedPromptContext['conversationGoal'] = 'educational';
  if (lowerMessage.includes('prove') || lowerMessage.includes('evidence') || lowerMessage.includes('defend')) {
    conversationGoal = 'apologetics';
  } else if (lowerMessage.includes('struggling') || lowerMessage.includes('help') || lowerMessage.includes('comfort')) {
    conversationGoal = 'pastoral';
  } else if (lowerMessage.includes('save') || lowerMessage.includes('gospel') || lowerMessage.includes('become christian')) {
    conversationGoal = 'evangelistic';
  } else if (lowerMessage.includes('grow') || lowerMessage.includes('deeper') || lowerMessage.includes('mature')) {
    conversationGoal = 'discipleship';
  }

  // Analyze previous topics
  const previousTopics = history
    .filter(msg => msg.metadata?.topics)
    .flatMap(msg => msg.metadata.topics)
    .filter((topic, index, self) => self.indexOf(topic) === index);

  return {
    questionType: determineQuestionType(message),
    userIntent: determineUserIntent(message),
    complexity: determineComplexity(message, history),
    sessionLength: history.length / 2,
    emotionalTone,
    theologicalPerspective: detectTheologicalPerspective(message, history),
    engagementLevel: calculateEngagementLevel(message, history),
    previousTopics,
    userKnowledgeLevel: assessKnowledgeLevel(message, history),
    conversationGoal
  };
}

// Helper functions for enhanced analysis
function determineQuestionType(message: string): EnhancedPromptContext['questionType'] {
  const lower = message.toLowerCase();
  if (lower.includes('god') || lower.includes('jesus') || lower.includes('bible') || 
      lower.includes('faith') || lower.includes('salvation')) {
    return 'theological';
  } else if (lower.includes('why') || lower.includes('how') || lower.includes('prove') ||
             lower.includes('logic') || lower.includes('reason')) {
    return 'philosophical';
  } else if (lower.includes('culture') || lower.includes('society') || lower.includes('modern')) {
    return 'cultural';
  } else if (lower.includes('i feel') || lower.includes('my') || lower.includes('personal')) {
    return 'personal';
  }
  return 'general';
}

function determineUserIntent(message: string): EnhancedPromptContext['userIntent'] {
  const lower = message.toLowerCase();
  if (lower.includes('wrong') || lower.includes('false') || lower.includes('disagree')) {
    return 'challenging';
  } else if (lower.includes('learn') || lower.includes('understand') || lower.includes('explain')) {
    return 'learning';
  } else if (lower.includes('struggling') || lower.includes('help') || lower.includes('difficult')) {
    return 'struggling';
  } else if (lower.includes('seek') || lower.includes('looking') || lower.includes('searching')) {
    return 'seeking';
  }
  return 'curious';
}

function determineComplexity(message: string, history: Array<any>): EnhancedPromptContext['complexity'] {
  const wordCount = message.split(' ').length;
  const hasAdvancedTerms = /theology|philosophy|doctrine|hermeneutics|epistemology/i.test(message);
  const conversationDepth = history.length;

  if (hasAdvancedTerms || wordCount > 50 || conversationDepth > 10) return 'advanced';
  if (wordCount > 20 || conversationDepth > 5) return 'intermediate';
  return 'basic';
}

function detectTheologicalPerspective(message: string, history: Array<any>): EnhancedPromptContext['theologicalPerspective'] {
  const allContent = [message, ...history.map(h => h.content)].join(' ').toLowerCase();
  
  if (allContent.includes('reformed') || allContent.includes('calvin') || allContent.includes('sovereignty')) {
    return 'reformed';
  } else if (allContent.includes('catholic') || allContent.includes('pope') || allContent.includes('mary')) {
    return 'catholic';
  } else if (allContent.includes('orthodox') || allContent.includes('tradition') || allContent.includes('fathers')) {
    return 'orthodox';
  } else if (allContent.includes('evangelical') || allContent.includes('born again')) {
    return 'evangelical';
  }
  return 'general';
}

function calculateEngagementLevel(message: string, history: Array<any>): EnhancedPromptContext['engagementLevel'] {
  const messageLength = message.length;
  const questionCount = (message.match(/\?/g) || []).length;
  const personalReferences = (message.match(/\b(I|me|my|mine)\b/gi) || []).length;
  
  const score = (messageLength / 100) + (questionCount * 2) + (personalReferences * 1.5) + (history.length * 0.5);
  
  if (score > 10) return 'deep';
  if (score > 5) return 'moderate';
  return 'surface';
}

function assessKnowledgeLevel(message: string, history: Array<any>): EnhancedPromptContext['userKnowledgeLevel'] {
  const advancedTerms = /systematic theology|hermeneutics|exegesis|soteriology|pneumatology|eschatology/i;
  const intermediateTerms = /doctrine|theology|scripture|gospel|salvation|trinity/i;
  
  if (advancedTerms.test(message)) return 'advanced';
  if (intermediateTerms.test(message)) return 'intermediate';
  if (history.length > 10) return 'intermediate';
  return 'beginner';
}

// Build comprehensive memory context
async function buildComprehensiveMemoryContext(
  userId: string,
  conversationId: string | undefined,
  currentMessage: string,
  conversationHistory: Array<any>,
  supabase: any
): Promise<any> {
  try {
    // Get enhanced memory from service
    const memoryData = await MemoryService.getEnhancedConversationContext(
      conversationId || 'default',
      userId,
      currentMessage,
      15 // Get more context
    );

    // Build from conversation history if no memory service data
    if (!memoryData || memoryData.messages.length === 0) {
      return buildEnhancedMemoryContext(conversationHistory);
    }

    return memoryData;
  } catch (error) {
    logger.error('Memory context error', error);
    return buildEnhancedMemoryContext(conversationHistory);
  }
}

// Select optimal model based on context
async function selectOptimalModel(
  mode: string,
  complexity: string,
  intensity: string,
  userId: string
): Promise<{ model: string; temperature: number; maxTokens: number }> {
  // Check subscription status
  const hasAdvanced = await SubscriptionMiddleware.checkApiFeatureAccess(userId, 'advanced_ai_models');
  
  if (mode === 'accurate' && hasAdvanced.allowed) {
    // Use most advanced model for complex queries
    if (complexity === 'advanced' || intensity === 'strong') {
      return {
        model: 'gpt-4-turbo-preview',
        temperature: 0.8,
        maxTokens: 4000
      };
    }
    return {
      model: 'gpt-4-turbo-preview',
      temperature: 0.7,
      maxTokens: 3000
    };
  }
  
  // Fast mode or no advanced access
  return {
    model: 'gpt-3.5-turbo-16k',
    temperature: 0.7,
    maxTokens: mode === 'fast' ? 1500 : 2500
  };
}

// Build enhanced message array
function buildEnhancedMessageArray(
  systemPrompt: string,
  conversationHistory: Array<any>,
  currentMessage: string,
  memoryContext: any,
  objectionAnalysis: ObjectionAnalysis
): Array<{ role: string; content: string }> {
  const messages = [{ role: 'system', content: systemPrompt }];

  // Add relevant memory context as system message
  if (memoryContext && memoryContext.messages.length > 0) {
    const memoryPrompt = `
Based on our previous conversations, here are the most relevant memories:
${memoryContext.messages.slice(0, 5).map(m => `- ${m.content}`).join('\n')}

Key topics we've discussed: ${memoryContext.keyTopics.join(', ')}
Emotional tone: ${memoryContext.emotionalTone}
`;
    messages.push({ role: 'system', content: memoryPrompt });
  }

  // Add conversation history
  conversationHistory.forEach(msg => {
    messages.push({
      role: msg.role,
      content: msg.content
    });
  });

  // Add current message
  messages.push({ role: 'user', content: currentMessage });

  return messages;
}

// Post-process response with enhancements
async function postProcessResponse(
  response: string,
  context: EnhancedPromptContext,
  analysis: ObjectionAnalysis,
  metadata: any
): Promise<string> {
  let enhanced = response;

  // Add scripture references if appropriate
  if (context.questionType === 'theological' && metadata.scriptureReferences.length < 3) {
    const additionalScriptures = await getRelevantScriptures(context.previousTopics[0]);
    enhanced = enhancedResponseModifiers.addScripture(enhanced, additionalScriptures);
  }

  // Add pastoral care for struggling users
  if (context.emotionalTone === 'negative' || context.userIntent === 'struggling') {
    enhanced = enhancedResponseModifiers.addPastoralCare(enhanced);
  }

  // Add resources for deeper study
  if (context.engagementLevel === 'deep' || context.userKnowledgeLevel === 'advanced') {
    const resources = getRecommendedResources(analysis.primaryType);
    enhanced = enhancedResponseModifiers.addApologeticResources(enhanced, resources);
  }

  // Add conversation continuation
  if (context.sessionLength > 3) {
    const nextTopics = suggestNextTopics(context, analysis);
    enhanced = enhancedResponseModifiers.addConversationContinuation(enhanced, nextTopics);
  }

  return enhanced;
}

// Helper functions for post-processing
async function getRelevantScriptures(topic: string): Promise<string[]> {
  const topicScriptures = {
    'salvation': ['John 3:16', 'Ephesians 2:8-9', 'Romans 10:9-10'],
    'suffering': ['Romans 8:28', 'James 1:2-4', '2 Corinthians 4:17-18'],
    'faith': ['Hebrews 11:1', 'Romans 10:17', 'James 2:17'],
    'prayer': ['Matthew 6:9-13', 'Philippians 4:6-7', '1 Thessalonians 5:17']
  };
  
  return topicScriptures[topic] || ['Psalm 119:105', 'Proverbs 3:5-6'];
}

function getRecommendedResources(objectionType: string): string[] {
  const resources = {
    'logical': [
      '"The Problem of Pain" by C.S. Lewis',
      '"God, Freedom, and Evil" by Alvin Plantinga',
      'ReasonableFaith.org - Problem of Evil resources'
    ],
    'moral': [
      '"Mere Christianity" by C.S. Lewis',
      '"The Moral Argument" by William Lane Craig',
      'RZIM.org - Moral apologetics resources'
    ],
    'scientific': [
      '"The Language of God" by Francis Collins',
      'Reasons.org - Science and faith resources',
      'BioLogos.org - Evolution and faith dialogue'
    ],
    'historical': [
      '"The Case for Christ" by Lee Strobel',
      '"The Resurrection of Jesus" by Mike Licona',
      '"Jesus and the Eyewitnesses" by Richard Bauckham'
    ]
  };
  
  return resources[objectionType] || [
    '"Basic Christianity" by John Stott',
    'Bible.org - Theological resources',
    'Ligonier.org - Reformed theology resources'
  ];
}

function suggestNextTopics(context: EnhancedPromptContext, analysis: ObjectionAnalysis): string[] {
  const suggestions = [];
  
  // Based on conversation goal
  if (context.conversationGoal === 'apologetics') {
    suggestions.push('Evidence for the resurrection of Jesus');
    suggestions.push('The reliability of the Bible');
    suggestions.push('Christianity and other worldviews');
  } else if (context.conversationGoal === 'pastoral') {
    suggestions.push('Finding hope in difficult times');
    suggestions.push('Practical steps for spiritual growth');
    suggestions.push('The role of community in healing');
  } else if (context.conversationGoal === 'evangelistic') {
    suggestions.push('What does it mean to follow Jesus?');
    suggestions.push('How can I know God personally?');
    suggestions.push('What happens after I believe?');
  }
  
  // Based on previous topics
  if (context.previousTopics.includes('theology')) {
    suggestions.push('The nature of God');
    suggestions.push('Understanding the Trinity');
  }
  
  return suggestions.slice(0, 3);
}

// Preserve important context when trimming history
function preserveImportantContext(history: Array<any>): Array<any> {
  // Keep first 2 exchanges
  const beginning = history.slice(0, 4);
  
  // Keep messages with high emotional tone or important topics
  const important = history.slice(4, -4).filter(msg => {
    return msg.metadata?.emotionalTone !== 'neutral' ||
           msg.metadata?.topics?.length > 2 ||
           msg.content.length > 500;
  });
  
  // Keep last 4 exchanges
  const recent = history.slice(-8);
  
  return [...beginning, ...important, ...recent];
}

// Enhanced analytics tracking
async function trackEnhancedAnalytics(
  userId: string,
  message: string,
  response: string,
  context: EnhancedPromptContext,
  analysis: ObjectionAnalysis,
  metadata: any,
  cid: string
): Promise<void> {
  try {
    await AnalyticsService.trackEnhancedInteraction({
      userId,
      correlationId: cid,
      message,
      responseLength: response.length,
      questionType: context.questionType,
      userIntent: context.userIntent,
      emotionalTone: context.emotionalTone,
      complexity: context.complexity,
      engagementLevel: context.engagementLevel,
      conversationGoal: context.conversationGoal,
      objectionType: analysis.primaryType,
      objectionIntensity: analysis.intensity,
      userStance: analysis.userStance,
      duration: metadata.elapsed,
      tokenCount: metadata.tokenCount,
      scriptureCount: metadata.scriptureReferences.length,
      topics: [...context.previousTopics, ...analysis.keyThemes]
    });
  } catch (error) {
    logger.error('Analytics tracking error', { cid, error });
  }
}

// Store enhanced conversation with rich metadata
async function storeEnhancedConversation(
  conversationId: string,
  message: string,
  response: string,
  context: EnhancedPromptContext,
  analysis: ObjectionAnalysis,
  userId: string,
  supabase: any
): Promise<void> {
  try {
    // Store user message
    await ChatService.addMessage(
      conversationId,
      message,
      'user',
      undefined,
      supabase
    );

    // Store assistant response with metadata
    const responseMessage = await ChatService.addMessage(
      conversationId,
      response,
      'assistant',
      context.conversationGoal === 'apologetics' ? 'accurate' : 'fast',
      supabase
    );

    // Store additional metadata
    await supabase
      .from('message_metadata')
      .insert({
        message_id: responseMessage.id,
        question_type: context.questionType,
        user_intent: context.userIntent,
        emotional_tone: context.emotionalTone,
        complexity: context.complexity,
        engagement_level: context.engagementLevel,
        conversation_goal: context.conversationGoal,
        objection_type: analysis.primaryType,
        objection_intensity: analysis.intensity,
        topics: [...context.previousTopics, ...analysis.keyThemes]
      });

  } catch (error) {
    logger.error('Store conversation error', error);
  }
}
